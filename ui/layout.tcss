Screen {
    layout: vertical;
}

#main {
    layout: horizontal;
    height: 1fr;
}

Sidebar {
    width: 30;
    padding: 1;
}

Narrative {
    padding: 1;
    width: 1fr;
}

Input {
    dock: bottom;
}

Header {
    content-align: center middle;
    height: 3;
    text-style: bold;
}
